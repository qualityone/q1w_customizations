{
  "compilerOptions": {
    "target": "ES6",
    "module": "ES6",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "N/*": ["__mocks__/N/*"],
      "third_party/*": ["src/FileCabinet/SuiteScripts/q1w_company/erp/project_name/third_party/*"]
    },
    "checkJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noResolve": false
  },
  "include": ["src/**/*", "gulp/**/*", "__mocks__/**/*"],
  "exclude": ["node_modules", "dist"]
}
