{
  "name": "q1w_project_template",
  "version": "1.0.0",
  "description": "NetSuite SDF Project Template with ES6 to AMD 2.1 transpilation",
  "main": "index.js",
  "scripts": {
    "build": "gulp",
    "build:notranspile": "gulp --mode=notranspile",
    "watch:build": "gulp watch",
    "clean": "gulp cleanBuild",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "deploy": "cd dist && suitecloud project:deploy",
    "deploy:dry": "cd dist && suitecloud project:deploy --dryrun",
    "validate": "cd dist && suitecloud project:validate",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/register": "^7.23.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "babel-plugin-preserve-comment-header": "^1.0.1",
    "babel-plugin-transform-es2015-modules-simple-desctructure-amd": "^0.1.0",
    "del": "^6.1.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.1.0",
    "gulp": "^4.0.2",
    "gulp-babel": "^8.0.0",
    "gulp-debug": "^4.0.0",
    "gulp-header": "^2.0.9",
    "gulp-rename": "^2.0.0",
    "husky": "^9.1.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0"
  },
  "keywords": [
    "netsuite",
    "sdf",
    "suitescript",
    "es6",
    "amd"
  ],
  "author": "Q1W",
  "license": "UNLICENSED",
  "private": true
}
